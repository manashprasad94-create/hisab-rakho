  "narrative": {
    "donts": [
      "Don't use green/red as decorative branding or neutral notification colors.",
      "Don't hide focus, fade disabled text or depend on color alone.",
      "Don't introduce arbitrary typography, radii, gradients or per-page systems."
    ],
    "overview": "Ink establishes trust and legibility; restrained marigold adds familiar warmth and memorable identity. People, amounts, and next actions read like a clear, friendly ledger. Shared white surfaces, muted supporting tools, and quiet dividers give the interface a dependable everyday character.",
    "dos": [
      "Do prioritize people, financial direction, amounts and required actions.",
      "Do reuse tokens/components across product and public screens.",
      "Do keep marigold restrained and status explicitly labeled.",
      "Do preserve contrast, comfortable targets and mobile wrapping."
    ],
    "rules": [
      {
        "body": "Always pair financial colors with explicit labels, signs, icons, or status text.",
        "name": "The Labeled Direction Rule",
        "section": "colors"
      },
      {
        "body": "Monetary amounts and form controls use tabular numerals. Long names, emails, and amounts wrap. Public-page headlines can be larger within the same family and palette.",
        "name": "The Ledger Numerals Rule",
        "section": "typography"
      },
      {
        "body": "Records inside grouped lists use dividers and surface tint for hover, without individual shadows.",
        "name": "The Flat Ledger Rule",
        "section": "elevation"
      }
    ],
    "northStar": "Ink & Marigold",
    "keyCharacteristics": [
      "Clear financial direction and tabular amounts.",
      "Restrained marigold identity within a neutral ledger.",
      "Comfortable controls and compact, readable record rows."
    ]
  }
